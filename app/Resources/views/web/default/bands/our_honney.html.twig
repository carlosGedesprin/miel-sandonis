{% set path = '/assets/images/web/'~config.website_skin~'/bands/our_honney/' %}
{#{% set img_1 = path ~ 'about_us_2.png' %}#}

<!-- HERO -->
{% include 'web/' ~ config.website_skin ~ '/bands/_hero.html.twig' with { hero: {
    size: 'home',
    image: 'nuestra-miel',
    position: 'center 70%',
    eyebrow: 'Nuestra miel',
    title: 'Miel de los Pinares de Portillo',
    subtitle: 'De nuestras colmenas, extraída en frío y envasada por nosotros.'
} } %}

<!-- DEL PANAL A TU MESA: secuencia de tres fotos -->
<section class="secuencia" aria-labelledby="secuencia-titulo">
    <div class="container">
        <h2 class="secuencia__titulo" id="secuencia-titulo">Del panal a tu mesa</h2>
        <ol class="secuencia__pasos">
            <li class="paso">
                <div class="paso__foto">
                    <img src="{{ path }}secuencia-pinar.jpg" width="800" height="1000" loading="lazy"
                         alt="Colmenas en fila bajo los pinos en un día de niebla" />
                    <span class="paso__num" aria-hidden="true">1</span>
                </div>
                <h3 class="paso__nombre">En el pinar</h3>
                <p class="paso__texto">Las colmenas pasan la temporada entre los pinos.</p>
            </li>
            <li class="paso">
                <div class="paso__foto">
                    <img src="{{ path }}secuencia-extraccion.jpg" width="800" height="1000" loading="lazy"
                         alt="Miel cayendo del grifo del extractor a un tarro de cristal" />
                    <span class="paso__num" aria-hidden="true">2</span>
                </div>
                <h3 class="paso__nombre">Extracción en frío</h3>
                <p class="paso__texto">Sin calentar la miel.</p>
            </li>
            <li class="paso">
                <div class="paso__foto">
                    <img src="{{ path }}secuencia-envasado.jpg" width="800" height="1000" loading="lazy"
                         alt="Manos pegando la etiqueta de Miel Sandonis en un tarro, junto a otros tarros ya etiquetados" />
                    <span class="paso__num" aria-hidden="true">3</span>
                </div>
                <h3 class="paso__nombre">Envasada por nosotros</h3>
                <p class="paso__texto">Tarro a tarro, etiquetado a mano.</p>
            </li>
        </ol>
    </div>
</section>

<!-- SI CRISTALIZA, ES BUENA SEÑAL (bloque verde .cta con foto) -->
<section class="cta cta--foto" aria-labelledby="cristaliza-titulo">
    <div class="container cta-foto__grid">
        <div class="cta-foto__imagen cta-foto__imagen--abajo">
            <img src="{{ path }}tarros-cristalizada.jpg" width="800" height="1000" loading="lazy"
                 alt="Estantería con tarros de Miel Sandonis; en la balda de abajo, miel ya cristalizada, más clara y cremosa" />
        </div>
        <div class="cta-foto__texto">
            <h2 id="cristaliza-titulo">Si cristaliza, es buena señal</h2>
            <p>La miel sin calentar cristaliza con el tiempo, y la nuestra lo hace de forma suave. Si la prefieres líquida, basta con ponerla al baño maría entre 35 y 40&nbsp;°C. Más calor le quita propiedades.</p>
        </div>
    </div>
</section>

<!-- DÓNDE ENCONTRARLA -->
{# El enlace "Ver la próxima feria" solo sale si el bloque de evento está visible (misma condición que bands/_evento.html.twig) #}
{% set hay_evento = evento is defined and evento.visible and date(evento.hasta ~ ' 23:59:59') >= date() %}
<section class="donde" aria-labelledby="donde-titulo">
    <div class="container">
        <h2 class="donde__titulo" id="donde-titulo">Dónde encontrarla</h2>
        <ul class="donde__lista">
            <li class="donde-item">
                <span class="donde-item__icono"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg></span>
                <h3 class="donde-item__nombre">En Portillo</h3>
                <p>Llámanos y quedamos para que la recojas.</p>
                <a class="donde-item__enlace donde-item__tel" href="tel:+34660790595">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                    660&nbsp;790&nbsp;595
                </a>
            </li>
            <li class="donde-item">
                <span class="donde-item__icono"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9 5 4h14l2 5"/><path d="M3 9c0 1.7 1.3 3 3 3s3-1.3 3-3c0 1.7 1.3 3 3 3s3-1.3 3-3c0 1.7 1.3 3 3 3s3-1.3 3-3"/><path d="M5 12v9h14v-9"/></svg></span>
                <h3 class="donde-item__nombre">En ferias</h3>
                <p>Vamos a mercados y ferias de la provincia de Valladolid.</p>
                {% if hay_evento %}
                    <a class="donde-item__enlace" href="#evento"><span>Ver la próxima feria</span> <span aria-hidden="true">↓</span></a>
                {% endif %}
            </li>
            <li class="donde-item">
                <span class="donde-item__icono"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
                <h3 class="donde-item__nombre">En tiendas</h3>
                <ul class="tiendas">
                    <li><strong>La alegría de la huerta</strong> Arrabal de Portillo</li>
                    <li><strong>Delicias Celia</strong> Arrabal de Portillo</li>
                    <li><strong>Autoservicio Luis</strong> Barrio de Delicias, Valladolid</li>
                </ul>
            </li>
        </ul>
    </div>
</section>
