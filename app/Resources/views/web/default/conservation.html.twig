{% extends 'web/' ~ config.website_skin ~ '.html.twig' %}

{% set this_page = 'conservation' %}
{% set this_route = '/conservacion' %}
{% set og_image = 'bands/conservation/conservation_1.jpg' %}

{% set this_page_title = 'Conservación y sostenibilidad | Miel Sandonis - protegemos las abejas' %}
{% set this_page_metadescription = 'Prácticas sostenibles para proteger las abejas y los Pinares de Portillo. Sin químicos, extracción ética y educación ambiental para preservar la biodiversidad de Castilla y León.' %}

{% block metadescription %}{{ this_page_metadescription }}{% endblock %}
{% block metarobots %}index, follow{% endblock %}

{% block title %}{{ this_page_title }}{% endblock %}

{% block body %}

    <div id="conservation_main">
        {% include 'web/' ~ config.website_skin ~ '/bands/conservation.html.twig' %}

	</div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="/assets/css/web/{{ config.website_skin }}/bands/conservation.css" rel="stylesheet">
{% endblock %}
