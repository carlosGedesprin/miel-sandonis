{% extends 'web/' ~ config.website_skin ~ '.html.twig' %}

{% set this_page = 'error404' %}

{% block metarobots %}noindex, nofollow{% endblock %}
{% block title %}Página no encontrada | {{ config.web_name }}{% endblock %}

{% block body %}

    <div id="error404_main">
        {% include 'web/' ~ config.website_skin ~ '/bands/_hero.html.twig' with { hero: {
            size: 'compact',
            image: 'pinar-niebla',
            title: 'Página no encontrada',
            subtitle: 'La página que buscas no existe o ha cambiado de dirección.',
            buttons: [
                { href: '/', label: 'Volver al inicio', style: 'primary' },
                { href: '/contacto', label: 'Contactar', style: 'outline' }
            ]
        } } %}
    </div>

{% endblock %}

