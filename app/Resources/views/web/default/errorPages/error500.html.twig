{% extends 'web/' ~ config.website_skin ~ '.html.twig' %}

{% set this_page = 'error500' %}

{% block metarobots %}noindex, nofollow{% endblock %}
{% block title %}Estamos actualizando la web | {{ config.web_name }}{% endblock %}

{% block body %}

    <div id="error500_main">
        {% include 'web/' ~ config.website_skin ~ '/bands/_hero.html.twig' with { hero: {
            size: 'compact',
            image: 'pinar-niebla',
            title: 'Estamos actualizando la web',
            subtitle: 'Estamos haciendo mejoras en esta página. Por favor, prueba de nuevo dentro de un rato.',
            buttons: [
                { href: '/', label: 'Volver al inicio', style: 'primary' },
                { href: '/contacto', label: 'Contactar', style: 'outline' }
            ]
        } } %}
    </div>

{% endblock %}

