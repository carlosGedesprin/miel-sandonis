{# URL base del sitio #}
{% set site_url = env.protocol~'://'~env.domain %}

{#
    Titular de la web (lo usan las páginas legales y los datos estructurados).
    PENDIENTE: nif (DNI de Conrado Pérez Ramos). Mientras esté vacío, las páginas legales muestran "[DNI pendiente]".
#}
{% set titular = {
    'nombre':    'Conrado Pérez Ramos',
    'nif':       '',
    'direccion': 'Calle Colegio, 13',
    'cp':        '47160',
    'localidad': 'Portillo',
    'provincia': 'Valladolid',
    'pais':      'España',
    'email':     'mielsandonis@gmail.com',
    'telefono':  '660 790 595',
    'telefono_2': '646 054 969'
} %}

{#
    Próxima feria o evento: bloque común encima del pie (bands/_evento.html.twig).
    - Para cambiarlo, editar estos datos y dejar el cartel en images/web/default/bands/evento/
      como <imagen>.jpg (640 px de ancho).
    - Para ocultarlo, visible: false. Además se oculta solo al día siguiente de `hasta` (AAAA-MM-DD).
#}
{% set evento = {
    'visible': true,
    'hasta':   '2026-11-29',
    'imagen':  'mercado-navideno-portillo-2026',
    'nombre':  'IV Mercado Navideño de Portillo',
    'texto':   'Mercado de Navidad con artesanía y productos de la zona. Estaremos con nuestra miel de los pinares de Portillo.',
    'donde':   'Plaza de la Villa, Portillo',
    'cuando':  '28 y 29 de noviembre',
    'horario': ['Sábado 28: de 17:30 a 20:00', 'Domingo 29: de 12:00 a 20:00']
} %}

{# Redes sociales: solo se usan las que tengan una URL real (se descartan los valores genéricos de relleno) #}
{% set placeholder_socials = ['https://facebook.com', 'https://facebook.com/', 'https://instagram.com', 'https://instagram.com/', 'https://twitter.com', 'https://twitter.com/', 'https://linkedin.com', 'https://linkedin.com/', 'https://youtube.com', 'https://youtube.com/', 'https://pinterest.com', 'https://pinterest.com/', 'https://www.skype.com'] %}
{% set social_links = [] %}
{%- for social_url in [config.company_instagram, config.company_twitter, config.company_linkedin, config.company_youtube, config.company_pinterest] -%}
    {%- if social_url is not empty and social_url not in placeholder_socials -%}
        {%- set social_links = social_links|merge([social_url]) -%}
    {%- endif -%}
{%- endfor %}

<!DOCTYPE html>
<html lang="{{ session[config['cookies_prefix']~'_locale'] }}" xml:lang="{{ session[config['cookies_prefix']~'_locale'] }}" prefix="og: https://ogp.me/ns#">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />

    <meta name="author" content="{{ config.web_meta_author }}" />

    {#
        Open Graph / Twitter: cada página define this_page_title, this_page_metadescription,
        this_route y, opcionalmente, og_image (ruta dentro de /assets/images/web/<skin>/)
    #}
    {% block seo_meta %}
        {% if this_page_title is defined %}
            {% set og_url = site_url ~ ((this_route is defined and this_route is not empty) ? this_route : '/') %}
            {% set og_image_url = site_url ~ '/assets/images/web/' ~ config.website_skin ~ '/' ~ (og_image is defined ? og_image : 'bands/hero/inicio-1920.jpg') %}
            <meta property="og:locale" content="es_ES" />
            <meta property="og:type" content="website" />
            <meta property="og:site_name" content="{{ config.web_name }}" />
            <meta property="og:title" content="{{ this_page_title }}" />
            {% if this_page_metadescription is defined %}
                <meta property="og:description" content="{{ this_page_metadescription }}" />
            {% endif %}
            <meta property="og:url" content="{{ og_url }}" />
            <meta property="og:image" content="{{ og_image_url }}" />
            <meta property="og:image:alt" content="{{ this_page_title }}" />
            <meta name="twitter:card" content="summary_large_image" />
            <meta name="twitter:title" content="{{ this_page_title }}" />
            {% if this_page_metadescription is defined %}
                <meta name="twitter:description" content="{{ this_page_metadescription }}" />
            {% endif %}
            <meta name="twitter:image" content="{{ og_image_url }}" />
        {% endif %}
    {% endblock %}

    <meta name="description" content="{% block metadescription %}{% endblock %}" />
    <meta name="robots" content="{% block metarobots %}{% endblock %}" />

    <meta name="keywords" content="{{ config.web_keywords }}" />
    <meta name="copyright" content="{{ config.web_copy_right }}" />
    <meta name="language" content="{{ session[config['cookies_prefix']~'_locale'] }}" />
    <meta name="rating" content="general" />
    <meta name="security" content="public" />
    <meta name="distribution" content="global" />
    <meta name="country" content="{{ config.web_meta_country }}" />
    <meta name="geo.region" content="ES-VA" />{# Valladolid (ISO 3166-2); fijo para no depender de la BD, que tenía ES-MAD #}
    <meta name="geo.country" content="{{ config.web_meta_geo_country }}" />
    <meta name="tgn.nation" content="{{ config.web_meta_geo_country }}" />

    {% if this_route is defined %}
        <link rel="canonical" href="{{ site_url ~ (this_route is empty ? '/' : this_route) }}" />
    {% endif %}
    {% block rel_alternate_links %}{% endblock %}

    {% set json_flags = constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "LocalBusiness",
            "@id": "{{ site_url }}/#organization",
            "name": {{ config.web_name|json_encode(json_flags)|raw }},
            "url": "{{ site_url }}",
            "logo": "{{ site_url }}/assets/images/web/{{ config.website_skin }}/bands/index_hero/logo.png",
            "image": "{{ site_url }}/assets/images/web/{{ config.website_skin }}/bands/hero/inicio-1920.jpg",
            "description": "Miel de los pinares de Portillo (Valladolid), extraída en frío y envasada por Conrado y Minerva, apicultores desde 2005. En ferias y tiendas de la zona.",
            "email": "mielsandonis@gmail.com",
            "telephone": "+34 660 790 595",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": {{ titular.direccion|json_encode(json_flags)|raw }},
                "postalCode": "{{ titular.cp }}",
                "addressLocality": {{ titular.localidad|json_encode(json_flags)|raw }},
                "addressRegion": {{ titular.provincia|json_encode(json_flags)|raw }},
                "addressCountry": "ES"
            },
            "areaServed": {
                "@type": "AdministrativeArea",
                "name": "Provincia de Valladolid"
            },
            "knowsAbout": [
                "Apicultura",
                "Miel de pinar",
                "Visitas a colmenas"
            ]{% if social_links is not empty %},
            "sameAs": {{ social_links|json_encode(json_flags)|raw }}{% endif %}

        }
    </script>
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": {{ config.web_name|json_encode(json_flags)|raw }},
            "url": "{{ site_url }}",
            "inLanguage": "es",
            "publisher": { "@id": "{{ site_url }}/#organization" }
        }
    </script>

    {% block ld_json %}{% endblock %}

    <title>{% block title %}{{ config.web_name }}{% if env.env_env == 'dev' %} · Dev · {{ server.SERVER_ADDR }}{% endif %}{% endblock %}</title>

    {% include 'web/' ~ config.website_skin ~ '/common/favicons.html.twig' %}

    {% block stylesheets %}
        {# Bootstrap #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
        {#<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-social/5.1.1/bootstrap-social.css" integrity="sha256-rnmbX+ZXZml9xbNUKt/qXfgpCi6zLJX7qqR+7vX/1ZY=" crossorigin="anonymous" rel="stylesheet" />#}
        {#<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" integrity="sha512-aOG0c6nPNzGk+5zjwyJaoRUgCdOrfSDhmMID2u4+OIslr0GjpLKo7Xm0Ao3xmpM4T8AmIouRkqwj1nrdVsLKEQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />#}
        {# Fonts #}
        <link rel="preconnect" href="https://fonts.gstatic.com">
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200..700&display=swap" rel="stylesheet">
        {#<link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet">#}
        {#<link href="https://fonts.googleapis.com/css?family=Lato:300,400,700" rel="stylesheet">#}
        {#<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@200..700&display=swap" rel="stylesheet">#}
        {#<link href="http://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">#}
        {#<link href="http://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400italic,700,900" rel="stylesheet">#}
        {#<link href="https://fonts.googleapis.com/css?family=Gochi+Hand|Lato:300,400|Montserrat:400,400i,700,700i" rel="stylesheet">#}
        {#<link href="https://use.fontawesome.com/releases/v5.1.0/css/all.css" integrity="sha384-lKuwvrZot6UHsBSfcMvOkWwlCMgc0TaWr+30HWe3a4ltaBwTZhyTEggF5tJv8tbt" crossorigin="anonymous" rel="stylesheet">#}
        {# Font Awesome #}
        {#<link href="//maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">#}
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.1/css/all.css">
        {# Simple Icons - https://simplelineicons.github.io/ #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/simple-line-icons/2.5.5/css/simple-line-icons.min.css">

        {# Our css s #}
        <link href="/bundles/framework/css/main-general.css" rel="stylesheet">
        <link href="/bundles/framework/css/bootstrap-extra.css" rel="stylesheet">

        <style>
            /* Variables heredadas (las usan algunos CSS antiguos). Apuntan a la paleta de main.css */
            :root {
                --white: var(--color-white);
                --black: var(--color-dark);
                --red: #b94040;

                --primary-color: var(--color-dark);
                --secondary-color: var(--color-text-muted);
                --tertiary-color: var(--color-text);
                --cuartiary-color: var(--color-card-border);
                --highlight-color: var(--color-green);
                --primary-background: var(--color-bg);
                --secondary-background: var(--color-bg-alt);
                --tertiary-background: var(--color-white);

                --new-dark-blue: var(--color-green-dark);
                --new-light-blue: var(--color-green-light);

                --box-border-radius: var(--radius);
                --button-border-radius: 6px;

                --general_font_size: 1rem;
                --title_1_font_size: 1.37rem;
                --title_2_font_size: 1.1rem;
            }
        </style>
        <link href="/assets/css/web/{{ config.website_skin }}/header.css" rel="stylesheet">
        <link href="/bundles/framework/css/web/{{ config.website_skin }}/main.css" rel="stylesheet">
        <link href="/bundles/framework/css/web/{{ config.website_skin }}/hero.css" rel="stylesheet">
        <link href="/bundles/framework/css/web/{{ config.website_skin }}/evento.css" rel="stylesheet">
        <link href="/bundles/framework/css/web/{{ config.website_skin }}/footer.css" rel="stylesheet">
    {% endblock %}

</head>
<body>

<a class="skip-link" href="#main">Saltar al contenido</a>

<style>
    {# Styles with twig commands #}
    :root
    {
        --scroll_width: 17px;
    }
    {# La altura de la cabecera y el margen de #main se definen en header.css (--header-height) #}
</style>

{% include 'web/' ~ config.website_skin ~ '/header.html.twig' %}

<main id="main" tabindex="-1">

    {% block body %}{% endblock %}

    {# Las páginas que colocan el bloque en otro sitio ponen evento_en_pagina = true #}
    {% if evento_en_pagina is not defined or not evento_en_pagina %}
        {% include 'web/' ~ config.website_skin ~ '/bands/_evento.html.twig' %}
    {% endif %}

    {# Sellos "Producto reconocido por": en todas las páginas, al final del contenido #}
    {% include 'web/' ~ config.website_skin ~ '/bands/_sellos.html.twig' %}

</main>

{% include 'web/' ~ config.website_skin ~ '/footer.html.twig' %}

{% block javascripts %}

    {# Bootstrap #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>

    {# onscroll animation #}
    {#<script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>#}

    <script src="/assets/js/web/{{ config.website_skin }}/header_menu.js"></script>

    <!-- accessability tool -->
    {#<script id="accessme" src="https://cdn.access-me.software/accssme/accssmetool.js"></script>#}
{% endblock %}
</body>
</html>
