{% set path = '/assets/images/web/'~config.website_skin~'/bands/contactus/' %}

<!-- HERO -->
{% include 'web/' ~ config.website_skin ~ '/bands/_hero.html.twig' with { hero: {
    image: 'contacto',
    title: 'Contacto',
    subtitle: 'Llámanos, escríbenos o búscanos en la próxima feria.'
} } %}

<!-- FORMAS DE CONTACTO: WhatsApp, teléfono y correo -->
