{% set path = '/assets/images/web/'~config.website_skin~'/bands/about_us/' %}
{#{% set img_1 = path ~ 'about_us_hero.png' %}#}

<!-- HERO: NOSOTROS -->
{% include 'web/' ~ config.website_skin ~ '/bands/_hero.html.twig' with { hero: {
    size: 'home',
    image: 'nosotros-feria',
    position: '35% 15%',
    eyebrow: 'Nosotros',
    title: 'Somos Conrado «Viky» y Minerva',
    subtitle: 'Más de 20 años y más de 170 colmenas en los pinares de Portillo. Sandonis es el apellido de Minerva.'
} } %}

<!-- CIFRAS -->
<section class="cifras" aria-label="Miel Sandonis en cifras">
    <div class="container">
        <ul class="cifras__lista">
            <li class="cifra">
                <span class="cifra__numero">2005</span>
                <span class="cifra__texto">Nuestras dos primeras colmenas</span>
            </li>
            <li class="cifra">
                <span class="cifra__numero"><span class="cifra__prefijo">más de </span>170</span>
                <span class="cifra__texto">Colmenas hoy</span>
            </li>
        </ul>
    </div>
</section>

<!-- CÓMO EMPEZAMOS -->
<section class="comienzo" aria-labelledby="comienzo-titulo">
    <div class="container comienzo__grid">
        <div class="comienzo__text">
            <h2 id="comienzo-titulo">Cómo empezamos</h2>
            <p>Nací en Portillo y siempre he estado ligado a estos pinares. La idea de tener abejas me rondaba desde hacía tiempo, pero ni Minerva ni yo veníamos de la apicultura ni conocíamos a nadie del gremio.</p>
            <p>El empujón llegó cuando un familiar de Minerva enfermó y empezamos a interesarnos por las propiedades de la miel. En 2005 conocimos a Anselmo, un apicultor de Renedo de Esgueva: le compramos miel y, ese mismo año, nuestras dos primeras colmenas. Nos hicimos socios de la asociación de apicultores de Valladolid, fuimos a los cursos y así empezamos.</p>
        </div>
        <div class="fotos-duo">
            <figure class="fotos-duo__foto">
                <img src="{{ path }}minerva-feria.jpg" width="800" height="1000" loading="lazy"
                     alt="Minerva en el puesto de Miel Sandonis de una feria, bajo la pancarta «Miel pura»" />
                <figcaption>Minerva</figcaption>
            </figure>
            <figure class="fotos-duo__foto fotos-duo__foto--abajo">
                <img src="{{ path }}conrado-colmenas.jpg" width="800" height="1000" loading="lazy"
                     alt="Conrado con traje de apicultor revisando una colmena entre los pinos" />
                <figcaption>Conrado «Viky»</figcaption>
            </figure>
        </div>
    </div>
</section>

<!-- UN AÑO EN EL COLMENAR -->
<section class="anio" aria-labelledby="anio-titulo">
    <div class="container">
        <h2 id="anio-titulo" class="anio__titulo">Un año en el colmenar</h2>
        <ol class="anio__etapas">
            <li class="etapa">
                <span class="etapa__icono"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1L19.1 4.9"/><path d="M9 3l3 3 3-3M9 21l3-3 3 3M3 9l3 3-3 3M21 9l-3 3 3 3"/></svg></span>
                <h3 class="etapa__nombre">Invierno</h3>
                <p class="etapa__texto">Fundimos cera y preparamos cajas y cuadros.</p>
            </li>
            <li class="etapa">
                <span class="etapa__icono"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21v-9"/><path d="M12 12c0-4 3-7 8-7 0 5-3 8-8 7z"/><path d="M12 14c0-3-2.5-5.5-7-5.5 0 4 2.5 6.5 7 5.5z"/></svg></span>
                <h3 class="etapa__nombre">Desde febrero</h3>
                <p class="etapa__texto">Revisamos las colmenas y ponemos panales.</p>
            </li>
            <li class="etapa">
                <span class="etapa__icono"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="2.5"/><path d="M12 9.5c-1.5-3-1-6 0-7 1 1 1.5 4 0 7zM14.5 12c3-1.5 6-1 7 0-1 1-4 1.5-7 0zM12 14.5c1.5 3 1 6 0 7-1-1-1.5-4 0-7zM9.5 12c-3 1.5-6 1-7 0 1-1 4-1.5 7 0z"/></svg></span>
                <h3 class="etapa__nombre">Primavera</h3>
                <p class="etapa__texto">Vigilamos los enjambres y tratamos los parásitos con productos orgánicos.</p>
            </li>
            <li class="etapa">
                <span class="etapa__icono"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
                <h3 class="etapa__nombre">Verano</h3>
                <p class="etapa__texto">Cosecha, y a preparar las colmenas para el invierno.</p>
            </li>
        </ol>
    </div>
</section>

<!-- LOS PINARES DE PORTILLO -->
<section class="pinares" aria-labelledby="pinares-titulo">
    <div class="container">
        <figure class="pinares__foto">
            <img src="{{ path }}pinares-flores-1600.jpg"
                 srcset="{{ path }}pinares-flores-900.jpg 900w, {{ path }}pinares-flores-1600.jpg 1600w"
                 sizes="(max-width: 1240px) 100vw, 1200px"
                 width="1600" height="900" loading="lazy"
                 alt="Colmena en el pinar entre flores blancas y amarillas, con los pinos detrás" />
            <figcaption class="pinares__texto">
                <h2 id="pinares-titulo">Los pinares de Portillo</h2>
                <p>De aquí sale el sabor de nuestra miel: savia de pino y tomillo.</p>
            </figcaption>
        </figure>
    </div>
</section>

<!-- GALERÍA: CUATRO FOTOS (componente .galeria, en main.css) -->
<section class="galeria" aria-label="Fotos del colmenar">
    <div class="container">
        <ul class="galeria__grid">
            <li class="galeria__item">
                <img src="{{ path }}galeria-flor.jpg" width="900" height="900" loading="lazy"
                     alt="Abeja dentro de una flor amarilla de calabaza" />
            </li>
            <li class="galeria__item">
                <img src="{{ path }}galeria-pinos.jpg" width="900" height="900" loading="lazy"
                     alt="Colmenas en fila bajo los pinos en un día de niebla" />
            </li>
            <li class="galeria__item">
                <img src="{{ path }}galeria-colmenar.jpg" width="900" height="900" loading="lazy"
                     alt="Colmenar entre pinos al pie de un cerro cubierto de pinar" />
            </li>
            <li class="galeria__item">
                <img src="{{ path }}galeria-panal.jpg" width="900" height="900" loading="lazy"
                     alt="Mano con guante sujetando un cuadro de panal con miel y abejas" />
            </li>
        </ul>
    </div>
</section>

<!-- EVENTOS EN LA EXPLOTACIÓN (bloque verde .cta) -->
<section class="cta" aria-labelledby="cta-titulo">
    <div class="container cta__inner">
        <h2 id="cta-titulo">Eventos en la explotación</h2>
        <p>De vez en cuando abrimos la explotación. Cuando haya un evento, lo anunciaremos aquí.</p>
    </div>
</section>
