                <a class="contacto-card contacto-card--whatsapp" href="https://wa.me/34660790595">
                    <span class="contacto-card__icono"><i class="fab fa-whatsapp" aria-hidden="true"></i></span>
                    <h3 class="contacto-card__nombre">WhatsApp</h3>
                    <span class="contacto-card__dato">660&nbsp;790&nbsp;595</span>
                </a>
            </li>
            <li>
                <div class="contacto-card">
                    <span class="contacto-card__icono"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg></span>
