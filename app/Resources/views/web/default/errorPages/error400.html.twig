{% extends 'web/' ~ config.website_skin ~ '.html.twig' %}

{% set this_page = 'error400' %}

{% block metarobots %}noindex, nofollow{% endblock %}
{% block title %}Solicitud no válida | {{ config.web_name }}{% endblock %}

{% block body %}

    <div id="error400_main">
        {% include 'web/' ~ config.website_skin ~ '/bands/_hero.html.twig' with { hero: {
            size: 'compact',
            image: 'pinar-niebla',
            title: 'Solicitud no válida',
            subtitle: 'No hemos podido procesar tu petición. Revisa la dirección o vuelve a intentarlo.',
            buttons: [
                { href: '/', label: 'Volver al inicio', style: 'primary' },
                { href: '/contacto', label: 'Contactar', style: 'outline' }
            ]
        } } %}
    </div>

{% endblock %}

