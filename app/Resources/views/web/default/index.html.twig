{% extends 'web/' ~ config.website_skin ~ '.html.twig' %}

{% set this_page = 'home' %}
{% set evento_en_pagina = true %}   {# el bloque de evento va encima de los sellos (bands/index_hero.html.twig) #}
{% set this_route = '' %}
{% set og_image = 'bands/hero/inicio-1920.jpg' %}
{% set this_page_title = 'Miel Sandonis | Miel de los Pinares de Portillo' %}
{% set this_page_metadescription = 'Miel de los pinares de Portillo (Valladolid), extraída en frío y envasada por Conrado y Minerva, apicultores desde 2005. En ferias y tiendas de la zona.' %}

{% block metadescription %}{{ this_page_metadescription }}{% endblock %}
{% block metarobots %}index, follow{% endblock %}

{% block title %}{{ this_page_title }}{% endblock %}

{% block body %}

    <div id="index_main">

		{% include 'web/' ~ config.website_skin ~ '/bands/index_hero.html.twig' %}

	</div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="/assets/css/web/{{ config.website_skin }}/bands/index_hero.css" rel="stylesheet">
{% endblock %}
