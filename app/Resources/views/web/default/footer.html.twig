<footer class="footer">
    <div class="container footer__grid">
        <div class="footer__col">
            <h2 class="footer__title">Miel Sandonis</h2>
            <p>Portillo (Valladolid)</p>
        </div>
        <div class="footer__col">
            <h2 class="footer__title">Enlaces rápidos</h2>
            {# Lista en web/default.html.twig (menu_paginas): no sale la página actual #}
            <ul>
                {% for enlace in menu_paginas %}
                    {% if this_page is not defined or enlace.page != this_page %}
                        <li><a href="{{ enlace.href }}">{{ enlace.label }}</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
        <div class="footer__col">
            <h2 class="footer__title">Contacto</h2>
            <ul class="footer__contact">
                <li><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg> <a href="mailto:mielsandonis@gmail.com">mielsandonis@gmail.com</a></li>
                <li><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg> <span><a href="tel:+34660790595">660&nbsp;790&nbsp;595</a> o <a href="tel:+34646054969">646&nbsp;054&nbsp;969</a></span></li>
            </ul>
        </div>
    </div>

    <section class="footer_legal" aria-label="Información legal">
        <div class="footer_legal_list">
            <a id="legal_stuff" class="footer_legal_item" href="/{{ lang.WEB_FOOTER_LEGALSTUFF_LINK }}">{{ lang.WEB_FOOTER_LEGALSTUFF | raw }}</a>
            <a id="privacy_policy" class="footer_legal_item" href="/{{ lang.WEB_FOOTER_PRIVACY_POLICY_LINK }}">{{ lang.WEB_FOOTER_PRIVACY_POLICY | raw }}</a>
            <a id="cookies_policy" class="footer_legal_item" href="/{{ lang.WEB_FOOTER_COOKIES_POLICY_LINK }}">{{ lang.WEB_FOOTER_COOKIES_POLICY | raw }}</a>
        </div>
    </section>

</footer>
