{% extends 'web/' ~ config.website_skin ~ '.html.twig' %}

{% set this_page = 'contactus' %}
{% set this_route = '/contacto' %}
{% set og_image = 'bands/contactus/contact_1.jpg' %}
{% set this_page_title = 'Contacto | Miel Sandonis – Teléfono, WhatsApp y visitas' %}
{% set this_page_metadescription = 'Escríbenos por WhatsApp o email, o llámanos al 660 790 595. También organizamos visitas a las colmenas en los pinares de Portillo.' %}

{% block metadescription %}{{ this_page_metadescription }}{% endblock %}
{% block metarobots %}index, follow{% endblock %}

{% block title %}{{ this_page_title }}{% endblock %}

{% block body %}

    <div id="contactus_main">

		{% include 'web/' ~ config.website_skin ~ '/bands/contactus.html.twig' %}

    </div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="/assets/css/web/{{ config.website_skin }}/bands/contactus.css" rel="stylesheet">
{% endblock %}
