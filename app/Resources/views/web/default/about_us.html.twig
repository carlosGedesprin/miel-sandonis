{% extends 'web/' ~ config.website_skin ~ '.html.twig' %}

{% set this_page = 'about_us' %}
{% set this_route = '/nosotros' %}
{% set og_image = 'bands/hero/nosotros-feria-1920.jpg' %}
{% set this_page_title = 'Nosotros | Miel Sandonis – Conrado y Minerva, apicultores en Portillo' %}
{% set this_page_metadescription = 'Miel Sandonis nació hace más de 20 años de la mano de un matrimonio apasionado por las abejas y el entorno natural de los Pinares de Portillo. Una historia de dedicación, respeto y apicultura sostenible en Valladolid.' %}

{% block metadescription %}{{ this_page_metadescription }}{% endblock %}
{% block metarobots %}index, follow{% endblock %}

{% block title %}{{ this_page_title }}{% endblock %}

{% block body %}

    <div id="about_us_main">

        {% include 'web/' ~ config.website_skin ~ '/bands/about_us.html.twig' %}

    </div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="/assets/css/web/{{ config.website_skin }}/bands/about_us.css" rel="stylesheet">
{% endblock %}
